# The image can be replaced with a pinned registry reference in deployments.
ANU_LAB_IMAGE=agent-native-universe-lab:local

# This exact hostname is routed by Traefik and receives an HTTP-01 certificate.
ANU_LAB_HOST=lab.anu.xteam.pro

# Fail-closed placeholder. Replace only with a rotated BasicAuth or SSO
# middleware that already exists in Traefik before enabling the edge profile.
ANU_LAB_AUTH_MIDDLEWARE=anu-lab-auth-required@docker

# Conservative defaults for the first logical experiment on the current host.
ANU_LAB_UNIVERSES=1
ANU_LAB_AGENTS=16
ANU_LAB_TICKS=500

# Hard shared-host safeguards for both observer and one-shot runner containers.
ANU_LAB_CPUS=2.0
ANU_LAB_MEMORY_LIMIT=2g
