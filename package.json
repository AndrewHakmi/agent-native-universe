{
  "name": "agent-native-universe",
  "version": "0.2.0",
  "description": "A distributed agent-native runtime with signed TCP transport, persistent graph recovery, Byzantine quorum, resource economy, LLM routing and fractal metaagents.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./distributed": {
      "types": "./dist/distributed-v1.d.ts",
      "import": "./dist/distributed-v1.js"
    }
  },
  "bin": {
    "anu": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "demo": "npm run build && node dist/examples/payment-network.js",
    "check": "npm run build && npm test",
    "demo:living": "npm run build && node dist/examples/living-network.js"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndrewHakmi/agent-native-universe.git"
  },
  "keywords": [
    "agents",
    "multi-agent",
    "agent-native",
    "distributed-systems",
    "byzantine-fault-tolerance",
    "emergent-architecture",
    "protocols",
    "runtime"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
